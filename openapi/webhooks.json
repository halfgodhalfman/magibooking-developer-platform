{
  "openapi": "3.1.0",
  "info": {
    "title": "MagiBooking Appointment Webhooks",
    "version": "0.2.0-preview.1",
    "description": "appointment.created is production; other events are staging preview. At-least-once, unordered delivery. Verify exact bytes and durably deduplicate by event ID."
  },
  "webhooks": {
    "appointment.created": {
      "post": {
        "summary": "Appointment created through the shared appointment creation service",
        "description": "Verify HMAC-SHA256 of timestamp + '.' + exact request bytes using the endpoint signing secret. Header signature format v1=<hex>; reject timestamps outside five minutes. Retry payload bytes and event/delivery IDs remain stable; request timestamps are refreshed.",
        "parameters": [
          {
            "in": "header",
            "name": "X-MagiBooking-Event-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-MagiBooking-Delivery-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-MagiBooking-Timestamp",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-MagiBooking-Signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreatedEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably received; duplicate event IDs must also be safely acknowledged."
          },
          "default": {
            "description": "Non-2xx, network errors and timeouts are retried up to 8 attempts. Redirects are never followed."
          }
        }
      }
    },
