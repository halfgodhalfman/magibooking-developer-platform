  "components": {
    "schemas": {
      "AppointmentCreatedEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created_at",
          "merchant_id",
          "location_id",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "appointment.created",
              "appointment.rescheduled",
              "appointment.cancelled",
              "payment.succeeded",
              "payment.failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "merchant_id": {
            "type": "string"
          },
          "location_id": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "appointment"
            ],
            "properties": {
              "appointment": {
                "type": "object",
                "required": [
                  "id",
                  "status",
                  "start_at",
                  "end_at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "start_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    }
